# Copy to .env and fill in. NEVER commit the real file.
# Load with:  set -a; source .env; set +a

# EOA private key that OWNS your Polymarket wallet (64 hex chars).
POLY_PRIVATE_KEY=

# Your Polymarket funding wallet (the address shown on your profile —
# deposit wallet / Safe / proxy). Leave empty to auto-bind the signer's
# deposit wallet.
POLY_WALLET=

# Relayer API key — REQUIRED for merges/redeems (gasless on-chain actions).
# Create at: polymarket.com → Settings → API Keys
# Copy BOTH the key and the address shown beside it. Do not paste anything else.
POLY_RELAYER_API_KEY=
POLY_RELAYER_API_KEY_ADDRESS=

# Optional overrides
# POLY_DRY_RUN=true
# POLY_LOG_LEVEL=DEBUG
